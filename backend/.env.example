HOST=127.0.0.1
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Render system
PUBLIC_URL=https://dofd.onrender.com
CORS_ORIGIN=https://dofd-1.onrender.com,http://localhost:5177,http://127.0.0.1:5177

# Database — Render Postgres (Strapi Cloud/Render provides DATABASE_URL)
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true

# Local SQLite fallback (dev only)
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# Yoxa live workflow trigger (hosted production, placeholder only — never commit real secret)
YOXA_TRIGGER_ENDPOINT=https://REPLACE-WITH-YOXA-HOST/api/v1/public/workflow-deployments/replace-with-deployment-id/trigger
YOXA_DEPLOYMENT_SECRET=replace-with-secret-from-yoxa
YOXA_TRIGGER_TEXT_PREFIX=Submitted external form

# Connector auth — required on hosted Render. Yoxa stores this after YAML upload.
YOXA_TOOL_API_KEY=replace-with-a-demo-tool-api-key
